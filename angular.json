{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "angular-vite-6": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/angular-vite-6",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob": "**/*", "input": "public"}, {"glob": "charlswasm_decode.wasm", "input": "node_modules/@cornerstonejs/codec-charls/dist", "output": "cs-dicom-loader/wasm"}, {"glob": "libjpegturbowasm_decode.wasm", "input": "node_modules/@cornerstonejs/codec-libjpeg-turbo-8bit/dist", "output": "cs-dicom-loader/wasm"}, {"glob": "openjpegwasm_decode.wasm", "input": "node_modules/@cornerstonejs/codec-openjpeg/dist", "output": "cs-dicom-loader/wasm"}, {"glob": "openjphjs.wasm", "input": "node_modules/@cornerstonejs/codec-openjph/dist", "output": "cs-dicom-loader/wasm"}],
            "styles": ["src/styles.css"],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "@cornerstonejs/codec-charls/decodewasmjs",
              "@cornerstonejs/codec-libjpeg-turbo-8bit/decodewasmjs",
              "@cornerstonejs/codec-openjpeg/decodewasmjs",
              "@cornerstonejs/codec-openjph/wasmjs",
              "dicom-parser",
              "fast-deep-equal",
              "lodash.get",
              "seedrandom",
              "spark-md5",
              "xmlbuilder2"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {"type": "initial", "maximumWarning": "4.5MB", "maximumError": "6MB"},
                {"type": "anyComponentStyle", "maximumWarning": "4kB", "maximumError": "8kB"}
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "subpath": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "baseHref": "/subpath/"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "prebundle": {
              "exclude": ["@cornerstonejs/dicom-image-loader"]
            }
          },
          "configurations": {
            "production": {"buildTarget": "angular-vite-6:build:production"},
            "development": {"buildTarget": "angular-vite-6:build:development"},
            "subpath": {"buildTarget": "angular-vite-6:build:subpath"}
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {"builder": "@angular-devkit/build-angular:extract-i18n"},
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "assets": [{"glob": "**/*", "input": "public"}, {"glob": "charlswasm_decode.wasm", "input": "node_modules/@cornerstonejs/codec-charls/dist", "output": "cs-dicom-loader/wasm"}, {"glob": "libjpegturbowasm_decode.wasm", "input": "node_modules/@cornerstonejs/codec-libjpeg-turbo-8bit/dist", "output": "cs-dicom-loader/wasm"}, {"glob": "openjpegwasm_decode.wasm", "input": "node_modules/@cornerstonejs/codec-openjpeg/dist", "output": "cs-dicom-loader/wasm"}, {"glob": "openjphjs.wasm", "input": "node_modules/@cornerstonejs/codec-openjph/dist", "output": "cs-dicom-loader/wasm"}],
            "styles": ["src/styles.css"],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {"analytics": "b23e6dda-73bb-44e7-ab30-4ac3fe77aed4"}
}
